# Copy to .env and fill in. NEVER commit real values. Generate each key with:  openssl rand -hex 32
# Every key must be different (the gateway refuses to start if two are equal).

NODE_ENV=production
PORT=8080
TRUST_PROXY=true                      # true only behind Cloudflare/AWS, so X-Forwarded-For is trusted

# One login role per service, each granted exactly one NOLOGIN group role (see infrastructure/db/migrations/001)
DATABASE_URL=postgres://gateway:CHANGE_ME@db:5432/fertility?sslmode=verify-full           # IN ROLE phi_app
WORKER_DATABASE_URL=postgres://engine:CHANGE_ME@db:5432/fertility?sslmode=verify-full     # IN ROLE engine_worker
IDENTITY_DATABASE_URL=postgres://identity:CHANGE_ME@db:5432/fertility?sslmode=verify-full # IN ROLE identity_app

JWT_SECRET=                           # >= 32 chars; shared with the identity service that issues tokens
JWT_ISSUER=fertility-identity
JWT_AUDIENCE=fertility-api

PSEUDONYM_KEY=                        # HMAC-SHA256: user_id -> subject_id
FIELD_ENCRYPTION_KEY=                 # AES-256-GCM for identity_vault.users.encrypted_pii (identity service only)
IP_HASH_KEY=                          # HMAC of client IPs in the audit log
EMAIL_HASH_KEY=                       # HMAC of e-mails for unique lookup

ENGINE_URL=http://biochem-engine:8000
ENGINE_TOKEN=                         # >= 32 chars; also set as ENGINE_TOKEN for the Python service

# Threshold set the engine uses. The app targets the Mira monitor; the Mira profile is PRELIMINARY (abstract-only source).
# Default (spec-provisional-1) is the product specification. See README "Evidence status".
ASSAY_PROFILE=spec-provisional-1
#ASSAY_PROFILE=mira-marquette-2021-preliminary

RATE_LIMIT_PER_MINUTE=120
